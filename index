/* ============ GRÁFICO NATIVO NO PDF ============ */
function desenharGraficoPdf(doc, r, marginX, yStart, larguraTotal){
  const cores = {
    massa:[217,138,61], recheio:[58,38,33], finalizacao:[168,64,92],
    embalagem:[110,88,80], margem:[92,122,84], margemNeg:[168,64,92]
  };
  const alturaGrafico = 60;
  const baseY = yStart + alturaGrafico;
  const maxValor = Math.max(1, r.precoVenda, r.custoUnitario);

  const larguraBarra = 34;
  const gap = 26;
  const xCusto = marginX + 15;
  const xPreco = xCusto + larguraBarra + gap;

  doc.setDrawColor(210);
  doc.line(marginX, baseY, marginX + larguraTotal, baseY);

  // Barra empilhada: custo unitário por componente
  let yCursor = baseY;
  const segmentosCusto = [
    { v:r.custoUnitMassa, cor:cores.massa, label:'Massa' },
    { v:r.custoUnitRecheio, cor:cores.recheio, label:'Recheio' },
    { v:r.custoUnitFinalizacao, cor:cores.finalizacao, label:'Calda/decoração' },
    { v:r.custoPote, cor:cores.embalagem, label:'Embalagem' },
  ];
  segmentosCusto.forEach(seg => {
    const h = (seg.v / maxValor) * (alturaGrafico - 6);
    const y = yCursor - h;
    doc.setFillColor(...seg.cor);
    doc.rect(xCusto, y, larguraBarra, h, 'F');
    yCursor = y;
  });
  doc.setFontSize(7);
  doc.setTextColor(40);
  doc.text(r.custoUnitario.toFixed(2).replace('.', ','), xCusto + larguraBarra / 2, yCursor - 2, { align:'center' });
  doc.text('Custo unitário', xCusto + larguraBarra / 2, baseY + 5, { align:'center' });

  // Barra: preço de venda (custo + margem)
  const hCusto = (r.custoUnitario / maxValor) * (alturaGrafico - 6);
  const hMargem = (Math.max(r.margemRS, 0) / maxValor) * (alturaGrafico - 6);
  doc.setFillColor(...cores.recheio);
  doc.rect(xPreco, baseY - hCusto, larguraBarra, hCusto, 'F');
  doc.setFillColor(...(r.margemRS >= 0 ? cores.margem : cores.margemNeg));
  doc.rect(xPreco, baseY - hCusto - hMargem, larguraBarra, hMargem, 'F');
  doc.setFontSize(7);
  doc.text(r.precoVenda.toFixed(2).replace('.', ','), xPreco + larguraBarra / 2, baseY - hCusto - hMargem - 2, { align:'center' });
  doc.text('Preço de venda', xPreco + larguraBarra / 2, baseY + 5, { align:'center' });

  // legenda
  const legendaY = baseY + 15;
  const itensLegenda = [
    { label:'Massa', cor:cores.massa }, { label:'Recheio', cor:cores.recheio },
    { label:'Calda/decoração', cor:cores.finalizacao }, { label:'Embalagem', cor:cores.embalagem },
    { label:'Margem (R$)', cor:cores.margem },
  ];
  let lx = marginX;
  let ly = legendaY;
  itensLegenda.forEach((item, idx) => {
    if (idx === 3){ lx = marginX; ly += 6; }
    doc.setFillColor(...item.cor);
    doc.rect(lx, ly - 2.8, 3, 3, 'F');
    doc.setFontSize(7.5);
    doc.setTextColor(40);
    doc.text(item.label, lx + 4.5, ly);
    lx += doc.getTextWidth(item.label) + 14;
  });

  return ly + 8;
}

/* ============ PDF ============ */
document.getElementById('btnPdf').addEventListener('click', () => {
  const btn = document.getElementById('btnPdf');
  const textoOriginal = btn.textContent;
  btn.disabled = true;
  btn.textContent = '⏳ Gerando...';

  try {
    if (!window.jspdf || !window.jspdf.jsPDF){
      throw new Error('A biblioteca de PDF não carregou. Verifique sua conexão com a internet e tente novamente.');
    }

    const r = recalc();
    const { jsPDF } = window.jspdf;
    const doc = new jsPDF({ unit:'mm', format:'a4' });
    const marginX = 15;
    const pageWidth = 210;
    const contentWidth = pageWidth - marginX * 2;
    let y = 18;

    doc.setFont('helvetica','bold');
    doc.setFontSize(17);
    doc.text('Relatório de Custo e Margem — Bolo no Pote', marginX, y);
    y += 6;
    doc.setFont('helvetica','normal');
    doc.setFontSize(9);
    doc.setTextColor(110);
    doc.text('Gerado em ' + new Date().toLocaleString('pt-BR'), marginX, y);
    doc.setTextColor(20);
    y += 10;

    function sectionTitle(t){
      doc.setFont('helvetica','bold');
      doc.setFontSize(12.5);
      doc.text(t, marginX, y);
      y += 2;
      doc.setDrawColor(220);
      doc.line(marginX, y, marginX + contentWidth, y);
      y += 6;
      doc.setFont('helvetica','normal');
      doc.setFontSize(9.5);
    }
    function row(label, value, bold){
      if (y > 275){ doc.addPage(); y = 18; }
      doc.setFont('helvetica', bold ? 'bold' : 'normal');
      doc.text(label, marginX, y);
      doc.text(value, marginX + contentWidth, y, { align:'right' });
      y += 5.5;
    }

    sectionTitle('Custos diretos por ingrediente — Massa');
    state.massa.ingredientes.forEach(i => row(i.nome, BRL(custoReceita(i))));
    row('Custo total da massa', BRL(state.massa.ingredientes.reduce((s,i)=>s+custoReceita(i),0)), true);
    row('Custo por pote (massa)', BRL(r.custoUnitMassa), true);
    y += 3;

    sectionTitle('Custos diretos por ingrediente — Recheio');
    state.recheio.ingredientes.forEach(i => row(i.nome, BRL(custoReceita(i))));
    row('Custo total do recheio', BRL(state.recheio.ingredientes.reduce((s,i)=>s+custoReceita(i),0)), true);
    row('Custo por pote (recheio)', BRL(r.custoUnitRecheio), true);
    y += 3;

    if (y > 230){ doc.addPage(); y = 18; }
    sectionTitle('Custos diretos por ingrediente — Calda e decoração');
    state.finalizacao.ingredientes.forEach(i => row(i.nome, BRL(custoReceita(i))));
    row('Pote (embalagem)', BRL(num(state.finalizacao.embalagemPote)));
    row('Custo total (calda + decoração)', BRL(state.finalizacao.ingredientes.reduce((s,i)=>s+custoReceita(i),0)), true);
    y += 3;

    if (y > 220){ doc.addPage(); y = 18; }
    sectionTitle('Produto final — custo unitário e margem');
    doc.setFont('helvetica','bold');
    doc.setFontSize(10.5);
    doc.text(r.nome, marginX, y);
    y += 5.5;
    doc.setFontSize(9.5);
    row('  Preço de venda', BRL(r.precoVenda));
    row('  Custo total (custo unitário)', BRL(r.custoUnitario), true);
    row('  Margem de contribuição', BRL(r.margemRS) + '  (' + r.margemPct.toFixed(1).replace('.',',') + '%)', true);
    y += 4;

    if (y > 190){ doc.addPage(); y = 18; }
    sectionTitle('Gráfico — custo por componente, preço e margem');
    desenharGraficoPdf(doc, r, marginX, y, contentWidth);

    doc.save('relatorio-custo-bolo-pote.pdf');
  } catch (err) {
    console.error(err);
    alert('Não foi possível gerar o PDF: ' + err.message);
  } finally {
    btn.disabled = false;
    btn.textContent = textoOriginal;
  }
});

